# Addis Eats · Environment Variables Configuration
# Copy this file to .env.local for local development.
# Configure these variables separately in Vercel for Preview and Production environments.

# -----------------------------------------------------------------------------
# Server-Side Secrets (NEVER prefix these with NEXT_PUBLIC_)
# Inaccessible to client-side browser JavaScript
# -----------------------------------------------------------------------------

# Secret key used for signing session tokens (HMAC-SHA256)
# Generate a strong 64-char key in production: openssl rand -hex 32
SESSION_SECRET="addis-eats-secure-session-secret-key-2026-production"

# Database Connection URI (if using external PostgreSQL/Mongo)
# DATABASE_URL="postgres://user:password@hostname:5432/addis_eats"

# Internal Kitchen Notification Webhook Key
# KITCHEN_DISPATCH_WEBHOOK_SECRET="whsec_addis_eats_kitchen_live_secret"

# -----------------------------------------------------------------------------
# Public Environment Variables (Prefixed with NEXT_PUBLIC_)
# Bundled into client JavaScript - ONLY non-sensitive configuration!
# -----------------------------------------------------------------------------

# Production base URL used for OpenGraph cards and canonical links
NEXT_PUBLIC_SITE_URL="https://addis-eats.vercel.app"

# Application Environment identifier (development, preview, production)
NEXT_PUBLIC_APP_ENV="production"
